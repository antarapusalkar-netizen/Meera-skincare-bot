# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# LLM providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# DRAFT_MODEL selects who writes the final post: "openai" or "claude"
DRAFT_MODEL=openai
SCORE_MODEL=gpt-4o-mini
OPENAI_DRAFT_MODEL=gpt-4o
ANTHROPIC_DRAFT_MODEL=claude-sonnet-5

# Notes scoring below this (1-10) are rejected instead of drafted
SCORE_THRESHOLD=6

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
